# --- LLM provider (bring your own key; pick one) ---
LLM_PROVIDER=anthropic        # anthropic | openai | gemini | openai-spec
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenAI-spec endpoint (vLLM, Ollama, LiteLLM, or any /chat/completions API).
# The provider appears in the chat UI only when the key, URL, and model list are all set.
# Models are comma-separated and show in the model dropdown.
OPENAI_SPEC_API_KEY=
OPENAI_SPEC_BASE_URL=
OPENAI_SPEC_MODELS=

# --- Agent Observability destination ---
# Fill in either block, or both. The chat UI lists each complete block and
# sends the selected destination with the question. SPLUNK_AO_DESTINATION is
# the one selected on load: standalone (Galileo) or o11y (Observability Cloud).
# Leave it blank to use the first configured destination.
SPLUNK_AO_DESTINATION=

# Galileo. These names are only for the standalone Galileo console.
# Sign up at https://app.galileo.ai/sign-up. Leave the console URL blank to
# use https://app.galileo.ai. Another instance looks like
# https://console.multitenant.galileocloud.io
GALILEO_API_KEY=
GALILEO_CONSOLE_URL=
GALILEO_PROJECT=splunk-mcp-with-agent-observability
GALILEO_LOG_STREAM=default

# Observability Cloud. These names are only for realm au0-style deployments.
# Realm is the {realm} in https://app.{realm}.observability.splunkcloud.com.
# The SDK derives the API and ingest hosts from the realm.
# One access token with ingest and API scopes goes in SPLUNK_AO_O11Y_TOKEN.
# Set SPLUNK_AO_O11Y_API_TOKEN only when project calls need a different token.
# https://agent-observability-docs.splunk.com/references/faqs/find-keys
SPLUNK_AO_REALM=
SPLUNK_AO_O11Y_TOKEN=
SPLUNK_AO_PROJECT=splunk-mcp-with-agent-observability
SPLUNK_AO_AGENT_STREAM=default

# --- Splunk MCP (provided by your workshop facilitator) ---
# Just the base instance URL — no port or path. scripts/setup_mcp.py derives
# the full MCP endpoint (https://<host>:8089/services/mcp) for you.
SPLUNK_INSTANCE_URL=
SPLUNK_MCP_TOKEN=
